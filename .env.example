# =====================================================================
# NagaQuest Environment Configuration
# =====================================================================

# Primary LLM: Google Gemini (supports comma-separated keys for auto-rotation)
VITE_GEMINI_API_KEY=your_gemini_key_1,your_gemini_key_2
VITE_GEMINI_MODEL=gemini-3-flash-preview

# Failover LLM: Groq (high-speed failover if Gemini quota is reached)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=qwen/qwen3.8-27b
